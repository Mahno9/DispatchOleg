{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Заполнение силуэта",
  "description": "Движок сам разбивает нарисованный силуэт на тетромино и роняет их сверху по одной. Игрок двигает и вращает падающую деталь; у каждой детали ровно одно правильное место — попала на него, фиксируется; легла мимо, рассыпается и подаётся заново.",
  "type": "object",
  "required": ["shape", "scoreThresholds"],
  "properties": {
    "levels": {
      "type": "array",
      "title": "Уровни",
      "description": "Уровни играются подряд, по нарастанию сложности. Поля уровня перекрывают одноимённые настройки ниже; что не задано — берётся оттуда. Список пуст — играется один силуэт из поля «Силуэт».",
      "default": [],
      "items": {
        "type": "object",
        "title": "Уровень",
        "properties": {
          "shape": {
            "type": "object",
            "title": "Силуэт",
            "description": "Клетки, которые нужно заполнить на этом уровне.",
            "x-type": "grid-paint",
            "x-max-size": 16,
            "required": ["width", "height", "rows"],
            "default": {
              "width": 4,
              "height": 4,
              "rows": [".##.", "####", "####", ".##."]
            },
            "properties": {
              "width": { "type": "integer", "title": "Ширина", "minimum": 1, "maximum": 16 },
              "height": { "type": "integer", "title": "Высота", "minimum": 1, "maximum": 16 },
              "rows": { "type": "array", "title": "Строки", "items": { "type": "string" } }
            }
          },
          "fallIntervalMs": {
            "type": "integer",
            "title": "Интервал падения, мс",
            "minimum": 150,
            "maximum": 3000
          },
          "lockDelayMs": {
            "type": "integer",
            "title": "Задержка фиксации, мс",
            "minimum": 0,
            "maximum": 2000
          },
          "hintAfterErrors": {
            "type": "integer",
            "title": "Подсказка после ошибок",
            "minimum": 0
          },
          "randomizeRotation": {
            "type": "boolean",
            "title": "Случайный поворот детали"
          },
          "spawnColumn": {
            "type": "string",
            "title": "Где появляется деталь",
            "enum": ["center", "target"],
            "x-enumLabels": { "center": "По центру", "target": "Над своим местом (проще)" }
          }
        }
      }
    },
    "shape": {
      "type": "object",
      "title": "Силуэт",
      "description": "Используется, если список уровней пуст. Разбиение на детали считается автоматически при запуске.",
      "x-type": "grid-paint",
      "x-max-size": 16,
      "required": ["width", "height", "rows"],
      "default": {
        "width": 4,
        "height": 4,
        "rows": [".##.", "####", "####", ".##."]
      },
      "properties": {
        "width": { "type": "integer", "title": "Ширина", "minimum": 1, "maximum": 16 },
        "height": { "type": "integer", "title": "Высота", "minimum": 1, "maximum": 16 },
        "rows": { "type": "array", "title": "Строки", "items": { "type": "string" } }
      }
    },
    "scoreThresholds": {
      "type": "array",
      "title": "Кривая баллов по времени",
      "description": "Баллы интерполируются по кривой. Для нуля за медленное прохождение добавьте точку с 0 баллов.",
      "x-type": "curve",
      "default": [
        { "maxSeconds": 20, "points": 300 },
        { "maxSeconds": 60, "points": 150 },
        { "maxSeconds": 180, "points": 0 }
      ],
      "items": {
        "type": "object",
        "required": ["maxSeconds", "points"],
        "properties": {
          "maxSeconds": { "type": "integer", "title": "Макс. секунд" },
          "points": { "type": "integer", "title": "Баллы" }
        }
      }
    },
    "errorPenalty": {
      "type": "integer",
      "title": "Штраф за ошибку",
      "description": "Сколько баллов снимается за одну ошибочную попытку установки. 0 — штрафа нет.",
      "default": 5,
      "minimum": 0
    },
    "hintAfterErrors": {
      "type": "integer",
      "title": "Подсказка после ошибок",
      "description": "После скольких ошибок по текущей детали включается призрак-подсказка. Гаснет после удачной подстановки. 0 — сразу.",
      "default": 3,
      "minimum": 0
    },
    "randomizeRotation": {
      "type": "boolean",
      "title": "Случайный поворот детали",
      "description": "Выдавать деталь в случайной из 4 ориентаций. Выкл — деталь сразу повёрнута правильно.",
      "default": true
    },
    "fallIntervalMs": {
      "type": "integer",
      "title": "Интервал падения, мс",
      "description": "Сколько миллисекунд деталь проводит на одной строке. Больше — медленнее и проще.",
      "default": 700,
      "minimum": 150,
      "maximum": 3000
    },
    "softDropFactor": {
      "type": "number",
      "title": "Ускорение мягкого спуска",
      "description": "Во сколько раз быстрее падает деталь, пока удерживается кнопка ⤓ (или ↓).",
      "default": 6,
      "minimum": 1,
      "maximum": 20
    },
    "lockDelayMs": {
      "type": "integer",
      "title": "Задержка фиксации, мс",
      "description": "Сколько деталь лежит на препятствии не на своём месте, прежде чем рассыпаться и засчитать ошибку. 0 — мгновенно.",
      "default": 500,
      "minimum": 0,
      "maximum": 2000
    },
    "spawnColumn": {
      "type": "string",
      "title": "Где появляется деталь",
      "description": "По центру поля или сразу над своим местом — второй вариант заметно проще.",
      "enum": ["center", "target"],
      "default": "center",
      "x-enumLabels": { "center": "По центру", "target": "Над своим местом (проще)" }
    },
    "barks": {
      "type": "object",
      "title": "Реплики персонажа",
      "description": "Короткие советы невпопад. Каждый диалог звучит не более одного раза за запуск, выбор случайный. Текст показывает платформа в нижней панели; префикс «{player}:» — реплика Олега.",
      "properties": {
        "pieceEvery": {
          "type": "integer",
          "title": "Совет после каждой N-й детали",
          "description": "0 — выкл.",
          "default": 3,
          "minimum": 0
        },
        "errorsEvery": {
          "type": "integer",
          "title": "Совет после каждой N-й ошибки",
          "description": "0 — выкл.",
          "default": 2,
          "minimum": 0
        },
        "onPieces": {
          "type": "array",
          "title": "Реплики · по ходу сборки",
          "default": [],
          "items": {
            "type": "object",
            "title": "Диалог",
            "properties": {
              "lines": {
                "type": "array",
                "title": "Фразы",
                "default": [],
                "items": { "type": "string" }
              },
              "phrasePauseMs": {
                "type": "integer",
                "title": "Пауза между фразами, мс",
                "default": 2200,
                "minimum": 0,
                "maximum": 60000
              },
              "finalHoldMs": {
                "type": "integer",
                "title": "Финальная пауза, мс",
                "default": 1500,
                "minimum": 0,
                "maximum": 60000
              }
            },
            "required": ["lines"]
          }
        },
        "onErrors": {
          "type": "array",
          "title": "Реплики · после ошибок",
          "default": [],
          "items": {
            "type": "object",
            "title": "Диалог",
            "properties": {
              "lines": {
                "type": "array",
                "title": "Фразы",
                "default": [],
                "items": { "type": "string" }
              },
              "phrasePauseMs": {
                "type": "integer",
                "title": "Пауза между фразами, мс",
                "default": 2200,
                "minimum": 0,
                "maximum": 60000
              },
              "finalHoldMs": {
                "type": "integer",
                "title": "Финальная пауза, мс",
                "default": 1500,
                "minimum": 0,
                "maximum": 60000
              }
            },
            "required": ["lines"]
          }
        }
      }
    },
    "sounds": {
      "type": "object",
      "title": "Звуки",
      "properties": {
        "music": { "type": "array", "title": "Музыка (луп)", "x-type": "asset:audio" },
        "rotate": { "type": "array", "title": "Поворот детали", "x-type": "asset:audio" },
        "move": { "type": "array", "title": "Сдвиг детали", "x-type": "asset:audio" },
        "place": { "type": "array", "title": "Успешная установка", "x-type": "asset:audio" },
        "error": { "type": "array", "title": "Отклонённая установка", "x-type": "asset:audio" },
        "hint": { "type": "array", "title": "Включение подсказки", "x-type": "asset:audio" },
        "levelDone": { "type": "array", "title": "Пробоина закрыта, есть следующая", "x-type": "asset:audio" },
        "win": { "type": "array", "title": "Силуэт собран", "x-type": "asset:audio" }
      }
    }
  }
}
