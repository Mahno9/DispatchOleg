# Скопировать в .env: cp .env.example .env
# Все значения опциональны — ниже указаны дефолты из server/src/config.ts.
# Но сам файл .env обязан существовать: server/package.json запускает
# tsx watch --env-file=../.env, и без файла Node падает.

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Ключ подписи cookie админ-сессии. В проде — заменить.
COOKIE_SECRET=dev-secret-change-me

# Ключ подписи QR-кодов. По умолчанию берётся COOKIE_SECRET.
# Смена инвалидирует все напечатанные QR.
# QR_SECRET=

HOST=0.0.0.0
PORT=8080

# БД app.sqlite и загруженные ассеты. В Docker — /data.
# DATA_DIR=../data

LOG_LEVEL=info
