        "n2": {
          "speaker": "44",
          "side": "right",
          "text": "Гранит. Он не жуёт, он утилизирует.",
          "next": "n4",
          "choices": []
        },
        "n3": {
          "speaker": "44",
          "side": "right",
          "text": "К-9. Приносит миску обратно. Пустую, вымытую и на место.",
          "next": "n4",
          "choices": []
        },
        "n4": {
          "speaker": "oleg",
          "side": "left",
          "text": "Запишу в сводку.",
          "next": null,
          "choices": []
        }
      }
    }
  },
