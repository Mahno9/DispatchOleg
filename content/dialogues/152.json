{
  "id": 152,
  "title": "Восточный мост · до",
  "nodes_json": {
    "start": "n1",
    "nodes": {
      "n1": {
        "speaker": "61",
        "side": "right",
        "text": "(вздох на всю частоту)",
        "next": "n2",
        "x": 4,
        "y": 8,
        "choices": null
      },
      "n2": {
        "speaker": "oleg",
        "side": "left",
        "text": "Я ещё ничего не сказал.",
        "next": "n3",
        "x": 24,
        "y": 8,
        "choices": null
      },
      "n3": {
        "speaker": "61",
        "side": "right",
        "text": "Это авансом.",
        "next": "n4",
        "x": 44,
        "y": 8,
        "choices": null
      },
      "n4": {
        "speaker": "oleg",
        "side": "left",
        "text": "Высотка у Восточного моста. Люди прыгают. Нужен ловец.",
        "next": "n5",
        "x": 64,
        "y": 8,
        "choices": null
      },
      "n5": {
        "speaker": "61",
        "side": "right",
        "text": "Принял. Полечу вдоль набережной.",
        "next": "n6",
        "x": 84,
        "y": 8,
        "choices": null
      },
      "n6": {
        "speaker": "oleg",
        "side": "left",
        "text": "Вдоль набережной дольше.",
        "next": "n7",
        "x": 4,
        "y": 24,
        "choices": null
      },
      "n7": {
        "speaker": "61",
        "side": "right",
        "text": "Знаю.",
        "next": null,
        "x": 24,
        "y": 24,
        "choices": [
          {
            "text": "Там люди, вообще-то.",
            "next": "a1"
          },
          {
            "text": "Маршрут вдоль набережной не согласован.",
            "next": "b1"
          },
          {
            "text": "Даже Блонде говорила, что ты можешь быстрее.",
            "next": "t1"
          }
        ]
      },
      "a1": {
        "speaker": "oleg",
        "side": "left",
        "text": "Там люди, вообще-то.",
        "next": "a2",
        "x": 4,
        "y": 40,
        "choices": null
      },
      "a2": {
        "speaker": "61",
        "side": "right",
        "text": "Завидую. У них хоть видно, что горит.",
        "next": "c1",
        "x": 24,
        "y": 40,
        "choices": null
      },
      "b1": {
        "speaker": "oleg",
        "side": "left",
        "text": "Маршрут вдоль набережной не согласован.",
        "next": "b2",
        "x": 4,
        "y": 52,
        "choices": null
      },
      "b2": {
        "speaker": "61",
        "side": "right",
        "text": "Пока согласуешь — как раз долечу.",
        "next": "c1",
        "x": 24,
        "y": 52,
        "choices": null
      },
      "c1": {
        "speaker": "oleg",
        "side": "left",
        "text": "Лети как хочешь, но встань под окна до первого прыжка.",
        "next": "c2",
        "x": 44,
        "y": 66,
        "choices": null
      },
      "c2": {
        "speaker": "61",
        "side": "right",
        "text": "Успею. Прыгать тоже никто не торопится.",
        "next": null,
        "x": 64,
        "y": 66,
        "choices": null
      },
      "t1": {
        "speaker": "oleg",
        "side": "left",
        "text": "Даже Блонде говорила, что ты можешь быстрее.",
        "next": "t2",
        "x": 4,
        "y": 80,
        "choices": null
      },
      "t2": {
        "speaker": "61",
        "side": "right",
        "text": "Когда?",
        "next": "t3",
        "x": 20,
        "y": 80,
        "choices": null
      },
      "t3": {
        "speaker": "oleg",
        "side": "left",
        "text": "...Это фигура речи.",
        "next": "t4",
        "x": 36,
        "y": 80,
        "choices": null
      },
      "t4": {
        "speaker": "61",
        "side": "right",
        "text": "Она говорила обо мне в настоящем времени или в прошедшем?",
        "next": "t5",
        "x": 52,
        "y": 80,
        "choices": null
      },
      "t5": {
        "speaker": "oleg",
        "side": "left",
        "text": "Феномачо, пожар.",
        "next": "t6",
        "x": 68,
        "y": 80,
        "choices": null
      },
      "t6": {
        "speaker": "61",
        "side": "right",
        "text": "Она ушла сквозь стену. Несущую.",
        "next": "t7",
        "x": 84,
        "y": 80,
        "choices": null
      },
      "t7": {
        "speaker": "oleg",
        "side": "left",
        "text": "Люди в окнах.",
        "next": "t8",
        "x": 4,
        "y": 92,
        "choices": null
      },
      "t8": {
        "speaker": "61",
        "side": "right",
        "text": "Проём до сих пор не заделали. Я проверяю по вторникам.",
        "next": "t9",
        "x": 20,
        "y": 92,
        "choices": null
      },
      "t9": {
        "speaker": "oleg",
        "side": "left",
        "text": "Сегодня четверг.",
        "next": "t10",
        "x": 36,
        "y": 92,
        "choices": null
      },
      "t10": {
        "speaker": "61",
        "side": "right",
        "text": "Знаю. Ещё пять дней держаться.",
        "next": "t11",
        "x": 52,
        "y": 92,
        "choices": null
      },
      "t11": {
        "speaker": "oleg",
        "side": "left",
        "text": "...Лети к мосту.",
        "next": "t12",
        "x": 68,
        "y": 92,
        "choices": null
      },
      "t12": {
        "speaker": "61",
        "side": "right",
        "text": "Лечу. Про проём дорасскажу на разборе.",
        "next": null,
        "x": 84,
        "y": 92,
        "choices": null
      }
    }
  }
}
