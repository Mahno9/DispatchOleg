{
  "id": 166,
  "title": "Мета · Гален · этап 3",
  "nodes_json": {
    "start": "n1",
    "nodes": {
      "n1": {
        "speaker": "60",
        "side": "right",
        "text": "Диспетчер, минуту. Наблюдение. Не как коллега — как медик.",
        "next": "n2",
        "x": 4,
        "y": 8,
        "choices": null
      },
      "n2": {
        "speaker": "oleg",
        "side": "left",
        "text": "Если про осанку — знаю. Дальше.",
        "next": "n3",
        "x": 24,
        "y": 8,
        "choices": null
      },
      "n3": {
        "speaker": "60",
        "side": "right",
        "text": "Про каналы. С Видией вы говорите тише регламента, с Блейзер — дольше регламента. Диагноз: конфликт интересов, двусторонний, в активной фазе.",
        "next": null,
        "x": 44,
        "y": 8,
        "choices": [
          {
            "text": "Поставь диагноз себе. Начни с наблюдательности.",
            "next": "n4"
          },
          {
            "text": "По регламенту диагнозы — только выездным.",
            "next": "n6"
          },
          {
            "text": "Промолчать",
            "next": "n8"
          }
        ]
      },
      "n4": {
        "speaker": "oleg",
        "side": "left",
        "text": "Поставь диагноз себе. Начни с наблюдательности.",
        "next": "n5",
        "x": 4,
        "y": 22,
        "choices": null
      },
      "n5": {
        "speaker": "60",
        "side": "right",
        "text": "Ставил. Гипертрофия наблюдательности. Но моя патология полезная, а ваша — по двум каналам сразу.",
        "next": "n9",
        "x": 24,
        "y": 22,
        "choices": null
      },
      "n6": {
        "speaker": "oleg",
        "side": "left",
        "text": "По регламенту диагнозы — только выездным.",
        "next": "n7",
        "x": 4,
        "y": 36,
        "choices": null
      },
      "n7": {
        "speaker": "60",
        "side": "right",
        "text": "Согласен. Оформил себе выезд: объект — диспетчерская, пострадавших — один, обнаружен на месте.",
        "next": "n9",
        "x": 24,
        "y": 36,
        "choices": null
      },
      "n8": {
        "speaker": "60",
        "side": "right",
        "text": "Молчание дольше четырёх секунд — подтверждение диагноза. Прошло шесть. Зафиксировал.",
        "next": "n9",
        "x": 4,
        "y": 50,
        "choices": null
      },
      "n9": {
        "speaker": "oleg",
        "side": "left",
        "text": "Знаешь, что в тебе бесит? Не диагнозы.",
        "next": "n10",
        "x": 44,
        "y": 64,
        "choices": null
      },
      "n10": {
        "speaker": "60",
        "side": "right",
        "text": "Знаю. Точность. Все так говорят — и всем становится легче, что я рядом. Обращайтесь.",
        "next": null,
        "x": 64,
        "y": 64,
        "choices": null
      }
    },
    "music": "/assets-store/mus-comic-routine.ogg"
  }
}
