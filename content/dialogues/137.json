    "nodes": {
      "n1": {
        "speaker": "55",
        "side": "right",
        "text": "Диспетчер, я на позиции. Руки вытянула. Стою.",
        "next": "n2",
        "x": 8,
        "y": 10,
        "choices": null
      },
      "n2": {
        "speaker": "oleg",
        "side": "left",
        "text": "Отлично. Почему никто не прыгает?",
        "next": "n3",
        "x": 30,
        "y": 10,
        "choices": null
      },
      "n3": {
        "speaker": "55",
        "side": "right",
        "text": "А ты подумай.",
        "next": "n4",
        "x": 52,
        "y": 10,
        "choices": null
      },
      "n4": {
        "speaker": "oleg",
        "side": "left",
        "text": "...Они тебя не видят.",
        "next": "n5",
        "x": 74,
        "y": 10,
        "choices": null
      },
      "n5": {
        "speaker": "55",
        "side": "right",
        "text": "Они видят асфальт, диспетчер. Просто асфальт. Один вернулся обратно в огонь. Он выбрал огонь.",
        "next": "n6",
        "x": 8,
        "y": 40,
        "choices": null
      },
      "n6": {
        "speaker": "oleg",
        "side": "left",
        "text": "Проявись.",
        "next": "n7",
        "x": 30,
        "y": 40,
        "choices": null
      },
      "n7": {
        "speaker": "55",
        "side": "right",
        "text": "Я проявлена. Я максимально проявлена. Это и есть максимум.",
        "next": null,
        "x": 52,
        "y": 40,
        "choices": [
          {
            "text": "Кричи. Пусть хоть слышат, куда падать.",
            "next": "n8"
          },
          {
            "text": "Дам тебе прожектор со второй машины.",
            "next": "n9"
          },
          {
            "text": "Держи руки. Разберёмся по ходу.",
            "next": "n10"
          }
        ]
      },
      "n8": {
        "speaker": "oleg",
        "side": "left",
        "text": "Кричи. Пусть хоть слышат, куда падать.",
        "next": "n11",
        "x": 78,
