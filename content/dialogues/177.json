{
  "id": 177,
  "title": "Мета · Гален · этап 5",
  "nodes_json": {
    "start": "n1",
    "nodes": {
      "n1": {
        "speaker": "60",
        "side": "right",
        "text": "Материй улетел семичасовым рейсом, можете не искать. На прощание помахал мне гипсом.",
        "next": "n2",
        "x": 4,
        "y": 8,
        "choices": null
      },
      "n2": {
        "speaker": "oleg",
        "side": "left",
        "text": "С переломом, дыркой в боку и стойким штаммом — и ты его отпустил?",
        "next": "n3",
        "x": 24,
        "y": 8,
        "choices": null
      },
      "n3": {
        "speaker": "60",
        "side": "right",
        "text": "Я его туда и направил. Горный воздух ему показан по всем пунктам.",
        "next": "n4",
        "x": 44,
        "y": 8,
        "choices": null
      },
      "n4": {
        "speaker": "oleg",
        "side": "left",
        "text": "А штамм?",
        "next": "n5",
        "x": 64,
        "y": 8,
        "choices": null
      },
      "n5": {
        "speaker": "60",
        "side": "right",
        "text": "Улетел с ним. Первый штамм в моей практике, который эмигрировал.",
        "next": null,
        "x": 84,
        "y": 8,
        "choices": null
      }
    },
    "music": "/assets-store/mus-comic-comedy.ogg"
  }
