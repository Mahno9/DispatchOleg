{
  "id": 149,
  "title": "Пробоина в отсеке · до",
  "nodes_json": {
    "start": "n1",
    "nodes": {
      "n1": {
        "speaker": "57",
        "side": "right",
        "text": "Диспетчер. Тут... ручка.",
        "next": "n2",
        "x": 4,
        "y": 8,
        "choices": null
      },
      "n2": {
        "speaker": "oleg",
        "side": "left",
        "text": "Что — ручка?",
        "next": "n3",
        "x": 24,
        "y": 8,
        "choices": null
      },
      "n3": {
        "speaker": "57",
        "side": "right",
        "text": "Осталась в руке. Вместе с дверью. И частью переборки.",
        "next": null,
        "x": 44,
        "y": 8,
        "choices": [
          {
            "text": "Насколько — частью?",
            "next": "n4"
          },
          {
            "text": "Опять?",
            "next": "n6"
          },
          {
            "text": "Промолчать",
            "next": "n8"
          }
        ]
      },
      "n4": {
        "speaker": "oleg",
        "side": "left",
        "text": "Насколько — частью?",
        "next": "n5",
        "x": 4,
        "y": 34,
        "choices": null
      },
      "n5": {
        "speaker": "57",
        "side": "right",
        "text": "Смотря откуда смотреть. Отсюда — почти вся.",
        "next": "n9",
        "x": 24,
        "y": 34,
        "choices": null
      },
      "n6": {
        "speaker": "oleg",
        "side": "left",
        "text": "Опять?",
        "next": "n7",
        "x": 4,
        "y": 52,
        "choices": null
      },
      "n7": {
        "speaker": "57",
        "side": "right",
        "text": "Я извинился. Перед дверью, перед переборкой. Перед всеми.",
        "next": "n9",
        "x": 24,
        "y": 52,
        "choices": null
      },
      "n8": {
        "speaker": "57",
        "side": "right",
        "text": "Вы молчите как мой инструктор по мелкой моторике.",
        "next": "n9",
        "x": 4,
        "y": 70,
        "choices": null
      },
      "n9": {
        "speaker": "oleg",
        "side": "left",
        "text": "Отойдите от пробоины. Заплатки поведу с пульта.",
        "next": "n10",
        "x": 44,
        "y": 88,
        "choices": null
      },
      "n10": {
        "speaker": "57",
        "side": "right",
        "text": "Я могу подержать...",
        "next": "n11",
        "x": 64,
        "y": 88,
        "choices": null
      },
      "n11": {
        "speaker": "oleg",
        "side": "left",
        "text": "Не надо держать. Ничего не надо держать.",
        "next": null,
        "x": 84,
        "y": 88,
        "choices": null
      }
    }
  }
